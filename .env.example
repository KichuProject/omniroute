# ==============================================================================
# OmniRoute Environment Configuration for Render Deployment
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Port & Binding (Render injects PORT automatically)
# PORT=10000
OMNIROUTE_SERVER_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# ⚠️ CRITICAL SECURITY SETTINGS (REQUIRED FOR PUBLIC CLOUD DEPLOYMENTS)
# ------------------------------------------------------------------------------
# By default, OmniRoute allows unauthenticated inference on /v1/*.
# On a public Render URL, you MUST enable API key validation so strangers cannot
# drain your LLM quotas.
REQUIRE_API_KEY=true

# Initial Admin Password for the Dashboard (/login)
# Change this before logging in the first time!
INITIAL_PASSWORD=CHANGEME

# JWT Secret for dashboard session cookies (generate random 64-char string)
JWT_SECRET=replace_with_a_long_random_secret_hash_here_for_jwt_tokens

# API Key Encryption Secret (encrypts provider API keys in SQLite database)
# Recommended: 32-byte hex string (e.g. openssl rand -hex 32)
API_KEY_SECRET=replace_with_a_32_char_hex_encryption_key_here

# ------------------------------------------------------------------------------
# PERSISTENT STORAGE (Optional for Render Persistent Disks)
# ------------------------------------------------------------------------------
# If you attach a Persistent Disk on Render mounted at /var/lib/omniroute,
# uncomment DATA_DIR so your keys, providers, and database persist across restarts.
# DATA_DIR=/var/lib/omniroute
